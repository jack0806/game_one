<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <title>Hexblast</title>
    <meta name="viewport" content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="full-screen" content="yes">
    <meta name="screen-orientation" content="landscape">
    <meta name="x5-fullscreen" content="true">
    <meta name="360-fullscreen" content="true">
    <meta name="theme-color" content="#05080c">
    <link rel="stylesheet" type="text/css" href="<%= cssUrl %>">
    <link rel="icon" href="favicon.ico">
  </head>
  <body>
    <main id="GameDiv" cc_exact_fit_screen="false" style="width: <%= previewWidth %>px; height: <%= previewHeight %>px;">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" width="<%= previewWidth %>" height="<%= previewHeight %>" tabindex="0" aria-label="Hexblast 游戏画面"></canvas>
      </div>
    </main>
    <%- include(cocosTemplate, {}) %>
  </body>
</html>
